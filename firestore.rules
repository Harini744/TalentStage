rules_version = '2';

// TalentStage security rules.
//
// NOTE: payments are SIMULATED (no real money moves). Because there is no
// backend, the client approving a milestone writes the freelancer's income
// transaction directly. Before handling real payments, move that logic into a
// Cloud Function / payment provider webhook and lock `transactions` writes down.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      // Freelancer directory: any signed-in user can read profiles.
      allow read: if signedIn();

      allow create: if isUser(uid)
        && request.resource.data.verified == false
        && request.resource.data.proMember == false;

      // Users can edit their own profile but can't grant themselves badges/ratings.
      allow update: if isUser(uid)
        && !changedKeys().hasAny(['verified', 'proMember', 'rating', 'email']);

      allow delete: if false;
    }

    // ------------------------------------------------------------- projects
    match /projects/{projectId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.clientId == request.auth.uid;

      // Owner can edit; anyone else may only bump the proposal counter (when bidding).
      allow update: if signedIn() && (
        resource.data.clientId == request.auth.uid ||
        changedKeys().hasOnly(['proposalsCount'])
      );
      allow delete: if signedIn() && resource.data.clientId == request.auth.uid;
    }

    // ------------------------------------------------------------ proposals
    match /proposals/{proposalId} {
      allow read: if signedIn() && (
        resource.data.freelancerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
      allow create: if signedIn()
        && request.resource.data.freelancerId == request.auth.uid
        && request.resource.data.status == 'Pending';
      // Only the project's client can change the status (e.g. mark as Hired).
      allow update: if signedIn()
        && resource.data.clientId == request.auth.uid
        && changedKeys().hasOnly(['status']);
    }

    // ------------------------------------------------------------ contracts
    match /contracts/{contractId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid
        && request.auth.uid in request.resource.data.participants;

      // Both parties can update milestones/links; only the client can change released funds.
      // (Restricting *which* status a freelancer may set would need per-field array rules.)
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && (
          request.auth.uid == resource.data.clientId ||
          request.resource.data.milestoneReleasedCount == resource.data.milestoneReleasedCount
        );

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/contracts/$(contractId)).data.participants;

        // getAfter() so the opening "System" message can be written in the same batch as the contract.
        allow create: if signedIn()
          && request.auth.uid in getAfter(/databases/$(database)/documents/contracts/$(contractId)).data.participants
          && (
            request.resource.data.senderId == request.auth.uid ||
            (
              request.resource.data.senderId == 'system' &&
              getAfter(/databases/$(database)/documents/contracts/$(contractId)).data.clientId == request.auth.uid
            )
          );
      }
    }

    // --------------------------------------------------------- transactions
    match /transactions/{transactionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;

      allow create: if signedIn() && (
        // Own withdrawal
        (request.resource.data.userId == request.auth.uid && request.resource.data.type == 'Withdrawal') ||
        // Client releasing a milestone payment to the freelancer
        (
          request.resource.data.clientId == request.auth.uid &&
          request.resource.data.userId != request.auth.uid &&
          request.resource.data.type == 'Income'
        )
      );
    }

    // ------------------------------------------------------------ community
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;

      // Anyone can like; only the author can edit anything else.
      allow update: if signedIn() && (
        resource.data.authorId == request.auth.uid ||
        changedKeys().hasOnly(['likes', 'likedBy'])
      );
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    // Challenges are curated: add/edit them in the Firebase console.
    match /challenges/{challengeId} {
      allow read: if signedIn();
      allow write: if false;

      match /submissions/{uid} {
        allow read: if isUser(uid);
        allow create, update: if isUser(uid) && request.resource.data.userId == request.auth.uid;
      }
    }
  }
}
